# ============================================================
# Rural Care Navigator — Environment Configuration Template
# ============================================================
# Copy this file to .env in the backend directory and fill in values.
# DO NOT commit .env files with real secrets.

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
PROJECT_NAME="Rural Care Navigator API"
ENVIRONMENT=development
# Accepted values: development | staging | production

# ──────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/rural_care_db

# ──────────────────────────────────────────────
# Security / JWT
# ──────────────────────────────────────────────
# Generate a strong random secret for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-strong-random-secret-before-deploying

JWT_ALGORITHM=HS256

# Token lifetime in minutes (60 = 1 hour)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ──────────────────────────────────────────────
# OTP / Authentication
# ──────────────────────────────────────────────
# OTP validity in minutes
OTP_EXPIRY_MINUTES=5

# Maximum invalid attempts allowed before lockout
OTP_MAX_ATTEMPTS=3

# Safe development/demo mode (avoids requiring real SMS provider during prototyping)
OTP_DEMO_MODE=true
DEMO_OTP=123456

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Development Vite default:
FRONTEND_ORIGIN=http://localhost:5173

# For multiple origins:
# FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

# ──────────────────────────────────────────────
# SMS Provider Configuration (Real SMS Delivery)
# ──────────────────────────────────────────────
# In development/demo mode, set OTP_DEMO_MODE=true and SMS_ENABLED=false.
# For production SMS dispatch, set OTP_DEMO_MODE=false and SMS_ENABLED=true.
SMS_PROVIDER=console
SMS_ENABLED=false
SMS_API_KEY=your_sms_gateway_api_key_here
SMS_API_SECRET=your_sms_gateway_api_secret_here
SMS_SENDER_ID=RURLCR
SMS_TEMPLATE_ID=your_dlt_template_id_here

# ──────────────────────────────────────────────
# External Integrations (future phases)
# ──────────────────────────────────────────────
# IVR_PROVIDER=mock
# IVR_API_KEY=

# AI_TRIAGE_MODE=mock
# AI_NAVIGATOR_MODE=mock

# ABDM_ENV=sandbox
# ABDM_CLIENT_ID=
# ABDM_CLIENT_SECRET=

