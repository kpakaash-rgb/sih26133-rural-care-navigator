# ──────────────────────────────────────────────
# Rural Care Navigator / MYTHRI Backend Configuration
# ──────────────────────────────────────────────

# Environment
ENVIRONMENT=production
PROJECT_NAME="Rural Care Navigator API"

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Security / JWT
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS / Allowed Frontend Origins
# Supports comma-separated origins, or regex matching for Vercel
FRONTEND_ORIGIN=https://sih26133-rural-care-navigator.vercel.app
FRONTEND_URL=https://sih26133-rural-care-navigator.vercel.app
ALLOWED_ORIGINS=https://sih26133-rural-care-navigator.vercel.app,http://localhost:5173
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Authentication / OTP
OTP_DEMO_MODE=false
DEMO_OTP=123456
OTP_EXPIRY_MINUTES=5

# SMS Provider (console / msg91 / fast2sms)
SMS_PROVIDER=console
SMS_ENABLED=false
